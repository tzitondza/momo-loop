# Local Docker Compose Postgres (default)
DATABASE_URL=postgresql+psycopg://momo:momo@127.0.0.1:5432/momo_loop

# Hosted examples:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Neon / Railway / Render / Supabase connection strings also work.

# JWT secret — change this in production
MOMO_LOOP_SECRET=momo-loop-hackathon-dev-secret-change-me

# Comma-separated frontend origins (avoid * in production)
# For single-URL Docker deploy, set this to the public site URL.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: path to built React app (production Docker sets this)
# FRONTEND_DIST=/app/frontend/dist
# PORT=8000
